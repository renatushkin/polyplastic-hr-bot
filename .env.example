# Корсик — пример настроек
# Скопируйте файл в .env и заполните свои значения.

# MAX
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru
ADMIN_MAX_USER_ID=

# Локальная LLM через Ollama
LLM_MODE=local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:1.7b

# База данных SQLite
DATABASE_PATH=runtime/korsik.db

# Необязательно: публичная ссылка на бота
KORSIK_BOT_URL=
